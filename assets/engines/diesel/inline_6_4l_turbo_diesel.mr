import "engine_sim.mr"

units units()
constants constants()
impulse_response_library ir_lib()

private node diesel_i6_connections {
    output cylinder_1: ignition_wire();
    output cylinder_2: ignition_wire();
    output cylinder_3: ignition_wire();
    output cylinder_4: ignition_wire();
    output cylinder_5: ignition_wire();
    output cylinder_6: ignition_wire();
}

public node diesel_i6_camshaft_builder {
    input intake_lobe_profile;
    input exhaust_lobe_profile;
    input intake_lobe_center: 112 * units.deg;
    input exhaust_lobe_center: 116 * units.deg;
    input base_radius: 0.75 * units.inch;

    output intake_cam: _intake_cam;
    output exhaust_cam: _exhaust_cam;

    camshaft_parameters params(base_radius: base_radius)
    camshaft _intake_cam(params, lobe_profile: intake_lobe_profile)
    camshaft _exhaust_cam(params, lobe_profile: exhaust_lobe_profile)

    label rotation(120 * units.deg)
    label rotation_360(360 * units.deg)

    // Firing order 1-5-3-6-2-4.
    _exhaust_cam
        .add_lobe((rotation_360 - exhaust_lobe_center) + 0 * rotation)
        .add_lobe((rotation_360 - exhaust_lobe_center) + 4 * rotation)
        .add_lobe((rotation_360 - exhaust_lobe_center) + 2 * rotation)
        .add_lobe((rotation_360 - exhaust_lobe_center) + 5 * rotation)
        .add_lobe((rotation_360 - exhaust_lobe_center) + 1 * rotation)
        .add_lobe((rotation_360 - exhaust_lobe_center) + 3 * rotation)

    _intake_cam
        .add_lobe(rotation_360 + intake_lobe_center + 0 * rotation)
        .add_lobe(rotation_360 + intake_lobe_center + 4 * rotation)
        .add_lobe(rotation_360 + intake_lobe_center + 2 * rotation)
        .add_lobe(rotation_360 + intake_lobe_center + 5 * rotation)
        .add_lobe(rotation_360 + intake_lobe_center + 1 * rotation)
        .add_lobe(rotation_360 + intake_lobe_center + 3 * rotation)
}

private node diesel_i6_head {
    input intake_camshaft;
    input exhaust_camshaft;
    input chamber_volume: 41.67 * units.cc;
    alias output __out: head;

    function intake_flow(50 * units.thou)
    intake_flow
        .add_flow_sample(0, 0)
        .add_flow_sample(50, 54)
        .add_flow_sample(100, 103)
        .add_flow_sample(150, 148)
        .add_flow_sample(200, 188)
        .add_flow_sample(250, 220)
        .add_flow_sample(300, 242)
        .add_flow_sample(350, 255)
        .add_flow_sample(400, 260)

    function exhaust_flow(50 * units.thou)
    exhaust_flow
        .add_flow_sample(0, 0)
        .add_flow_sample(50, 42)
        .add_flow_sample(100, 82)
        .add_flow_sample(150, 119)
        .add_flow_sample(200, 151)
        .add_flow_sample(250, 177)
        .add_flow_sample(300, 196)
        .add_flow_sample(350, 207)
        .add_flow_sample(400, 212)

    generic_cylinder_head head(
        chamber_volume: chamber_volume,
        intake_runner_volume: 180 * units.cc,
        intake_runner_cross_section_area: 9.0 * units.cm2,
        exhaust_runner_volume: 130 * units.cc,
        exhaust_runner_cross_section_area: 7.5 * units.cm2,
        intake_port_flow: intake_flow,
        exhaust_port_flow: exhaust_flow,
        valvetrain: standard_valvetrain(
            intake_camshaft: intake_camshaft,
            exhaust_camshaft: exhaust_camshaft
        )
    )
}

public node inline_6_4l_turbo_diesel {
    alias output __out: engine;

    diesel_i6_connections connections()

    engine engine(
        name: "4.0 L Turbocharged Inline-6 Diesel",
        starter_torque: 300 * units.lb_ft,
        starter_speed: 260 * units.rpm,
        dyno_min_speed: 700 * units.rpm,
        dyno_max_speed: 4200 * units.rpm,
        redline: 4200 * units.rpm,
        fuel: fuel(
            name: "Reference Diesel",
            molecular_mass: 170.34 * units.g,
            energy_density: 45.5 * units.kJ / units.g,
            density: 0.832 * units.kg / units.L,
            molecular_afr: 18.5,
            molecular_oxygen_ratio: 18.5,
            product_mole_ratio: 25.0 / 19.5,
            max_burning_efficiency: 0.95,
            burning_efficiency_randomness: 0.02
        ),
        hf_gain: 0.004,
        noise: 0.12,
        jitter: 0.05,
        simulation_frequency: 30000
    )

    label bore(95.0 * units.mm)
    label stroke(94.0528 * units.mm)
    label rod_length(160 * units.mm)
    label compression_height(34 * units.mm)
    label crank_mass(32 * units.kg)
    label flywheel_mass(18 * units.kg)
    label flywheel_radius(7.5 * units.inch)

    crankshaft crank(
        throw: stroke / 2,
        flywheel_mass: flywheel_mass,
        mass: crank_mass,
        friction_torque: 20 * units.lb_ft,
        moment_of_inertia:
            disk_moment_of_inertia(mass: crank_mass, radius: stroke / 2)
            + disk_moment_of_inertia(
                mass: flywheel_mass,
                radius: flywheel_radius
            ),
        position_x: 0,
        position_y: 0,
        tdc: constants.pi / 2
    )

    rod_journal journal_1(angle: 0 * units.deg)
    rod_journal journal_2(angle: 480 * units.deg)
    rod_journal journal_3(angle: 240 * units.deg)
    rod_journal journal_4(angle: 600 * units.deg)
    rod_journal journal_5(angle: 120 * units.deg)
    rod_journal journal_6(angle: 360 * units.deg)

    crank
        .add_rod_journal(journal_1)
        .add_rod_journal(journal_2)
        .add_rod_journal(journal_3)
        .add_rod_journal(journal_4)
        .add_rod_journal(journal_5)
        .add_rod_journal(journal_6)

    piston_parameters piston_params(
        mass: 750 * units.g,
        blowby: 0,
        compression_height: compression_height,
        wrist_pin_position: 0,
        displacement: 0
    )

    connecting_rod_parameters rod_params(
        mass: 900 * units.g,
        moment_of_inertia: rod_moment_of_inertia(
            mass: 900 * units.g,
            length: rod_length
        ),
        center_of_mass: 0,
        length: rod_length
    )

    cylinder_bank_parameters bank_params(
        bore: bore,
        deck_height: stroke / 2 + rod_length + compression_height
    )

    intake turbo_intake(
        plenum_volume: 5.0 * units.L,
        plenum_cross_section_area: 35 * units.cm2,
        intake_flow_rate: k_carb(850),
        runner_flow_rate: k_carb(320),
        runner_length: 18 * units.inch,
        idle_flow_rate: k_carb(0),
        idle_throttle_plate_position: 1.0,
        velocity_decay: 0.3,
        max_boost_pressure: 18 * units.psi,
        spool_time: 0.42 * units.sec,
        compressor_efficiency: 0.74,
        turbo_reference_exhaust_flow: 3.0,
        turbo_sound_volume: 0.34,
        wastegate_sound_volume: 0.18,
        turbo_whine_frequency: 5200
    )

    exhaust_system_parameters exhaust_params(
        outlet_flow_rate: k_carb(1600),
        primary_tube_length: 32 * units.inch,
        primary_flow_rate: k_carb(420),
        velocity_decay: 0.65,
        volume: 18 * units.L
    )

    exhaust_system exhaust(
        exhaust_params,
        length: 110 * units.inch,
        audio_volume: 0.95,
        impulse_response: ir_lib.mild_exhaust_0_reverb
    )

    cylinder_bank bank(bank_params, angle: 0)
    label spacing(0.75 * units.inch)
    bank
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.08)),
            connecting_rod: connecting_rod(rod_params),
            rod_journal: journal_1,
            intake: turbo_intake,
            exhaust_system: exhaust,
            ignition_wire: connections.cylinder_1,
            primary_length: spacing * 5,
            sound_attenuation: 0.92
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.08)),
            connecting_rod: connecting_rod(rod_params),
            rod_journal: journal_2,
            intake: turbo_intake,
            exhaust_system: exhaust,
            ignition_wire: connections.cylinder_2,
            primary_length: spacing * 4,
            sound_attenuation: 0.95
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.08)),
            connecting_rod: connecting_rod(rod_params),
            rod_journal: journal_3,
            intake: turbo_intake,
            exhaust_system: exhaust,
            ignition_wire: connections.cylinder_3,
            primary_length: spacing * 3,
            sound_attenuation: 0.98
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.08)),
            connecting_rod: connecting_rod(rod_params),
            rod_journal: journal_4,
            intake: turbo_intake,
            exhaust_system: exhaust,
            ignition_wire: connections.cylinder_4,
            primary_length: spacing * 3,
            sound_attenuation: 0.98
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.08)),
            connecting_rod: connecting_rod(rod_params),
            rod_journal: journal_5,
            intake: turbo_intake,
            exhaust_system: exhaust,
            ignition_wire: connections.cylinder_5,
            primary_length: spacing * 4,
            sound_attenuation: 0.95
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.08)),
            connecting_rod: connecting_rod(rod_params),
            rod_journal: journal_6,
            intake: turbo_intake,
            exhaust_system: exhaust,
            ignition_wire: connections.cylinder_6,
            primary_length: spacing * 5,
            sound_attenuation: 0.92
        )

    engine.add_cylinder_bank(bank)
    engine.add_crankshaft(crank)

    harmonic_cam_lobe intake_lobe(
        duration_at_50_thou: 195 * units.deg,
        gamma: 1.05,
        lift: 9.0 * units.mm,
        steps: 128
    )
    harmonic_cam_lobe exhaust_lobe(
        duration_at_50_thou: 205 * units.deg,
        gamma: 1.05,
        lift: 9.2 * units.mm,
        steps: 128
    )
    diesel_i6_camshaft_builder camshaft(
        intake_lobe_profile: intake_lobe,
        exhaust_lobe_profile: exhaust_lobe
    )
    bank.set_cylinder_head(
        diesel_i6_head(
            chamber_volume: 41.67 * units.cc,
            intake_camshaft: camshaft.intake_cam,
            exhaust_camshaft: camshaft.exhaust_cam
        )
    )

    function injection_timing(700 * units.rpm)
    injection_timing
        .add_sample(0 * units.rpm, 7 * units.deg)
        .add_sample(700 * units.rpm, 8 * units.deg)
        .add_sample(1500 * units.rpm, 11 * units.deg)
        .add_sample(2500 * units.rpm, 14 * units.deg)
        .add_sample(3500 * units.rpm, 17 * units.deg)
        .add_sample(4500 * units.rpm, 18 * units.deg)

    diesel_injection_module injection(
        injection_timing_curve: injection_timing,
        rev_limit: 4200 * units.rpm,
        limiter_duration: 0.08 * units.sec,
        idle_fuel_mass: 5.0 * units.mg,
        max_fuel_mass: 90 * units.mg,
        injection_duration: 24 * units.deg,
        ignition_delay: 0.0009 * units.sec,
        cetane_number: 50,
        minimum_ignition_temperature: 610 * units.K,
        premixed_burn_fraction: 0.24,
        premixed_burn_duration: 8 * units.deg,
        diffusion_burn_duration: 52 * units.deg,
        combustion_noise: 0.18
    )
    injection
        .connect_injector(connections.cylinder_1, 0 * units.deg)
        .connect_injector(connections.cylinder_5, 120 * units.deg)
        .connect_injector(connections.cylinder_3, 240 * units.deg)
        .connect_injector(connections.cylinder_6, 360 * units.deg)
        .connect_injector(connections.cylinder_2, 480 * units.deg)
        .connect_injector(connections.cylinder_4, 600 * units.deg)
    engine.add_diesel_injection_module(injection)
}

private node diesel_i6_transmission {
    alias output __out:
        transmission(max_clutch_torque: 700 * units.lb_ft)
            .add_gear(4.17)
            .add_gear(2.34)
            .add_gear(1.52)
            .add_gear(1.14)
            .add_gear(0.87)
            .add_gear(0.69);
}

private node diesel_i6_vehicle {
    alias output __out:
        vehicle(
            mass: 2200 * units.kg,
            drag_coefficient: 0.42,
            cross_sectional_area: (78 * units.inch) * (72 * units.inch),
            diff_ratio: 3.73,
            tire_radius: 15.5 * units.inch,
            rolling_resistance: 420 * units.N
        );
}

public node main {
    set_engine(inline_6_4l_turbo_diesel())
    set_transmission(diesel_i6_transmission())
    set_vehicle(diesel_i6_vehicle())
}
