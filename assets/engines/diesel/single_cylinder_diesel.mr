import "engine_sim.mr"

units units()
constants constants()
impulse_response_library ir_lib()

private node cylinder_connections {
    output cylinder_1: ignition_wire();
}

public node single_cylinder_diesel {
    alias output __out: engine;

    engine engine(
        name: "0.52 L Direct-Injection Diesel",
        starter_torque: 90 * units.lb_ft,
        starter_speed: 320 * units.rpm,
        redline: 3600 * units.rpm,
        fuel: fuel(
            name: "Reference Diesel",
            molecular_mass: 170.34 * units.g,
            energy_density: 45.5 * units.kJ / units.g,
            density: 0.832 * units.kg / units.L,
            molecular_afr: 18.5,
            molecular_oxygen_ratio: 18.5,
            product_mole_ratio: 25.0 / 19.5,
            max_burning_efficiency: 0.95,
            burning_efficiency_randomness: 0.03
        ),
        hf_gain: 0.003,
        noise: 0.18,
        jitter: 0.08,
        simulation_frequency: 40000
    )

    cylinder_connections connections()

    crankshaft crank(
        throw: 71.5 * units.mm / 2,
        flywheel_mass: 12 * units.lb,
        mass: 8 * units.lb,
        friction_torque: 7.0 * units.lb_ft,
        moment_of_inertia: 0.11,
        position_x: 0.0,
        position_y: 0.0,
        tdc: constants.pi / 2
    )

    rod_journal journal(angle: 0.0)
    crank.add_rod_journal(journal)

    piston_parameters piston_params(
        mass: 620 * units.g,
        compression_height: 1.0 * units.inch,
        wrist_pin_position: 0.0,
        displacement: 0.0
    )

    connecting_rod_parameters rod_params(
        mass: 520 * units.g,
        moment_of_inertia: 0.0030,
        center_of_mass: 0.0,
        length: 6.0 * units.inch
    )

    cylinder_bank_parameters bank_params(
        bore: 96 * units.mm,
        deck_height: 71.5 * units.mm / 2 + 6.0 * units.inch + 1.0 * units.inch
    )

    intake intake(
        plenum_volume: 2.0 * units.L,
        plenum_cross_section_area: 12.0 * units.cm2,
        intake_flow_rate: k_carb(180.0),
        idle_flow_rate: k_carb(0.0),
        idle_throttle_plate_position: 1.0,
        velocity_decay: 0.35,
        max_boost_pressure: 12.0 * units.psi,
        spool_start_rpm: 900 * units.rpm,
        spool_full_rpm: 2200 * units.rpm,
        spool_time: 0.35 * units.sec,
        compressor_efficiency: 0.72
    )

    exhaust_system_parameters exhaust_params(
        outlet_flow_rate: k_carb(600.0),
        primary_tube_length: 26.0 * units.inch,
        primary_flow_rate: k_carb(250.0),
        velocity_decay: 0.5,
        volume: 6.0 * units.L
    )

    exhaust_system exhaust(
        exhaust_params,
        audio_volume: 1.25,
        impulse_response: ir_lib.mild_exhaust_0_reverb
    )

    cylinder_bank bank(bank_params, angle: 0 * units.deg)
    bank.add_cylinder(
        piston: piston(piston_params, blowby: k_28inH2O(0.05)),
        connecting_rod: connecting_rod(rod_params),
        rod_journal: journal,
        intake: intake,
        exhaust_system: exhaust,
        ignition_wire: connections.cylinder_1
    )

    engine.add_cylinder_bank(bank)
    engine.add_crankshaft(crank)

    harmonic_cam_lobe cam_lobe(
        duration_at_50_thou: 190 * units.deg,
        gamma: 1.0,
        lift: 260 * units.thou,
        steps: 128
    )

    vtwin90_camshaft_builder camshaft(
        lobe_profile: cam_lobe,
        lobe_separation: 112 * units.deg,
        base_radius: 500 * units.thou
    )

    bank.set_cylinder_head(
        generic_small_engine_head(
            chamber_volume: 31 * units.cc,
            intake_camshaft: camshaft.intake_cam_0,
            exhaust_camshaft: camshaft.exhaust_cam_0,
            flow_attenuation: 1.4,
            intake_runner_cross_section_area: 8.0 * units.cm2,
            exhaust_runner_cross_section_area: 7.0 * units.cm2
        )
    )

    function injection_timing(1000 * units.rpm)
    injection_timing
        .add_sample(0000 * units.rpm, 8 * units.deg)
        .add_sample(1000 * units.rpm, 10 * units.deg)
        .add_sample(2000 * units.rpm, 13 * units.deg)
        .add_sample(3000 * units.rpm, 16 * units.deg)
        .add_sample(4000 * units.rpm, 18 * units.deg)

    diesel_injection_module injection(
        injection_timing_curve: injection_timing,
        rev_limit: 3600 * units.rpm,
        limiter_duration: 0.08 * units.sec,
        idle_fuel_mass: 3.0 * units.mg,
        max_fuel_mass: 45.0 * units.mg,
        injection_duration: 20 * units.deg,
        ignition_delay: 0.0012 * units.sec,
        cetane_number: 50.0,
        minimum_ignition_temperature: 620 * units.K,
        premixed_burn_fraction: 0.28,
        premixed_burn_duration: 9 * units.deg,
        diffusion_burn_duration: 48 * units.deg,
        combustion_noise: 0.22
    )
    injection.connect_injector(connections.cylinder_1, 0 * units.deg)
    engine.add_diesel_injection_module(injection)
}

private node diesel_transmission {
    alias output __out: transmission;

    transmission transmission(max_clutch_torque: 160 * units.lb_ft)
    transmission.add_gear(3.60)
    transmission.add_gear(2.20)
    transmission.add_gear(1.45)
    transmission.add_gear(1.00)
    transmission.add_gear(0.78)
}

private node diesel_vehicle {
    alias output __out:
        vehicle(
            mass: 900 * units.kg,
            drag_coefficient: 0.35,
            cross_sectional_area: (60 * units.inch) * (65 * units.inch),
            diff_ratio: 4.10,
            tire_radius: 12 * units.inch,
            rolling_resistance: 240 * units.N
        );
}

public node main {
    set_engine(single_cylinder_diesel())
    set_transmission(diesel_transmission())
    set_vehicle(diesel_vehicle())
}
